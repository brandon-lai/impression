# Optional. Without it the app runs in no-database mode: everything works
# client-side, and sharing falls back to a self-contained URL fragment.
DATABASE_URL=

# Optional. Without it /api/transcribe returns 503 and the final pass keeps
# the live Web Speech transcript.
GROQ_API_KEY=

# Required only when DATABASE_URL is set: Supabase Storage for audio + stills.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
